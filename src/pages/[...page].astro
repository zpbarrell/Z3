---
import { getCollection, render } from 'astro:content';
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import RaceSchedule from '../components/RaceSchedule.astro';
import { navigation } from '../data/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({
    params: { page: entry.id === 'home' ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isHome = entry.id === 'home';
const current = navigation.find((item) => item.href === Astro.url.pathname);
---

<BaseLayout title={entry.data.title} description={entry.data.description} showFooter={!isHome}>
  {isHome && <div class="home-media"><Content /></div>}
  {!isHome && <>
  <div class="page-heading">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{current?.number ?? '01'} / {entry.data.title}</p>
    <h1>{entry.data.title}<span class="heading-period" aria-hidden="true">.</span></h1>
    <p class="page-description">{entry.data.description}</p>
  </div>
  <div class="page-body">
    <article class="prose" aria-label={`${entry.data.title} content`}>
      <Content />
    </article>
    {entry.id === 'schedule' && <RaceSchedule />}
    <a class="back-link" href="/">Back to home <ArrowUpRight size={18} aria-hidden="true" /></a>
  </div>
  </>}
</BaseLayout>