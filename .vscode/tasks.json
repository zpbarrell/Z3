{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Astro development server",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"4321"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Preview updated Astro content",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"4322"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Restart Astro preview",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--force",
				"--host",
				"127.0.0.1",
				"--port",
				"4321"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build Astro website",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Test schedule map",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"--yes",
				"tsx",
				"--test",
				"tests/race-dates.test.mjs",
				"tests/schedule-map.test.ts"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Check Astro types",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"check"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}